<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_custom_toolbar"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="#76ead7"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/Action_LeftButton"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_weight="0.5"
        android:background="@color/dark_green"
        android:scaleType="center"
        android:scaleX="2"
        android:scaleY="2"
        android:src="@drawable/action_back_image"
        tools:ignore="SpeakableTextPresentCheck"
        />

    <TextView
        android:id="@+id/Action_Title"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/dark_green"
        android:gravity="center"
        android:text="@string/title_tool_bar"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textColor="#76ead7"
        android:textSize="@dimen/large_size"
        />

    <ImageButton
        android:id="@+id/Action_RightButton"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_weight="0.5"
        android:background="@color/dark_green"
        android:scaleType="center"
        android:scaleX="2"
        android:scaleY="2"
        android:src="@drawable/setting_image"
        />

</androidx.appcompat.widget.LinearLayoutCompat>